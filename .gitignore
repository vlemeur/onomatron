# Data and models
data/*
# data/external/ ships as an EMPTY directory: only .gitkeep is committed.
# The raw name lists (*.txt) dropped in it are local-only inputs (e.g. from
# licensed datasets) and stay gitignored on purpose.
!data/external/
data/external/*
!data/external/.gitkeep
/models/
*.pt

# Notebook checkpoints
.ipynb_checkpoints/

